{
    "name": "pollora/object-cache",
    "description": "A persistent Redis object cache for WordPress, built for Pollora and Laravel.",
    "keywords": [
        "pollora",
        "wordpress",
        "laravel",
        "redis",
        "cache",
        "object-cache"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Olivier Gorzalka",
            "email": "olivier@amphibee.fr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^13.38",
        "illuminate/console": "^13.38",
        "illuminate/container": "^13.38",
        "illuminate/contracts": "^13.38",
        "illuminate/support": "^13.38"
    },
    "require-dev": {
        "antecedent/patchwork": "^2.2",
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.22.1",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^3.8.2",
        "phpstan/phpstan": "^2.1.16",
        "pollora/harness": "^0.1.34"
    },
    "suggest": {
        "ext-redis": "Required to reach Redis with phpredis; without it the object cache falls back to WordPress's in-memory cache.",
        "ext-igbinary": "A faster, smaller serializer for cached values."
    },
    "autoload": {
        "psr-4": {
            "Pollora\\ObjectCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pollora\\ObjectCache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@phpstan",
            "@lint:check"
        ],
        "test:unit": "pest",
        "phpstan": "phpstan analyse",
        "phpstan:ci": "phpstan analyse --no-progress",
        "lint": "pint",
        "lint:check": "pint --test",
        "qa": "@php vendor/bin/pollora-qa check",
        "qa:fast": "@php vendor/bin/pollora-qa check --fast"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Pollora\\ObjectCache\\Infrastructure\\Laravel\\ObjectCacheServiceProvider"
            ]
        }
    }
}
