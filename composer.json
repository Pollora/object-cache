{
    "name": "pollora/object-cache",
    "description": "A persistent Redis object cache for WordPress, built for Pollora and Laravel.",
    "keywords": [
        "pollora",
        "wordpress",
        "laravel",
        "redis",
        "cache",
        "object-cache"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Olivier Gorzalka",
            "email": "olivier@amphibee.fr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "antecedent/patchwork": "dev-master#d588654e5c1304810b038db2b5c98d39b6f76c61 as 2.2.6",
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.22.1",
        "pestphp/pest": "^3.8.2",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/phpstan": "^2.1.16",
        "pollora/harness": "^0.1.41"
    },
    "suggest": {
        "ext-redis": "Required to reach Redis with phpredis; without it the object cache falls back to WordPress's in-memory cache.",
        "ext-igbinary": "A faster, smaller serializer for cached values.",
        "wp-cli/wp-cli": "Runs `wp object-cache enable|disable|status|flush` on a classic WordPress or Bedrock site."
    },
    "autoload": {
        "psr-4": {
            "Pollora\\ObjectCache\\": "src/"
        },
        "files": [
            "src/Infrastructure/WpCli/register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pollora\\ObjectCache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@phpstan",
            "@lint:check"
        ],
        "test:unit": "pest",
        "phpstan": "phpstan analyse",
        "phpstan:ci": "phpstan analyse --no-progress",
        "lint": "pint",
        "lint:check": "pint --test",
        "qa": "@php vendor/bin/pollora-qa check",
        "qa:fast": "@php vendor/bin/pollora-qa check --fast"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
